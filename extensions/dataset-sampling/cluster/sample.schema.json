{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trustdrop:schema:cluster-sample:v1",
  "title": "TrustDrop wallet-cluster sample",
  "allOf": [
    { "$ref": "urn:trustdrop:schema:chain-intelligence:v2" },
    {
      "type": "object",
      "properties": {
        "manifest": {
          "type": "object",
          "properties": {
            "sample": {
              "type": "object",
              "required": ["kind", "selection"],
              "properties": {
                "kind": { "const": "wallet-cluster-id" },
                "selection": {
                  "type": "object",
                  "required": ["wallet_cluster_ids"],
                  "properties": {
                    "wallet_cluster_ids": {
                      "type": "array",
                      "items": { "type": "string", "pattern": "^wcl_[0-9a-f]{24}$" },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "required": ["sample"]
        },
        "entity_flows": { "type": "array", "maxItems": 0 },
        "cluster_subgraphs": { "type": "array", "minItems": 1 }
      }
    }
  ]
}
