# Host-side directories used by docker/seller/docker-compose.yml.
# On the Mac mini these defaults match the migrated TrustDrop environment.
# For another host, set absolute paths; the helper script expands ~/.sui to an absolute path.

# Host Sui wallet/config directory. It is mounted into the Walrus publisher
# container as /home/justin/.sui and must contain sui_config/client.yaml plus
# the Sui keystore files used by the publisher.
TRUSTDROP_SUI_DIR=~/.sui

# Host Walrus config directory. It is mounted read-only into the Walrus
# publisher container as /home/justin/walrus and must contain client_config.yaml.
TRUSTDROP_WALRUS_CONFIG_DIR=~/walrus

# Host Cargo cache used by the seller daemon build/runtime container.
TRUSTDROP_CARGO_HOME=~/.cargo-trustdrop-justin

# Host seller state directory, mounted as /root/.trustdrop. This holds sale
# state, local .cipher assets, daemon lock/status, and thread records.
TRUSTDROP_STATE_DIR=~/.trustdrop

# Host directory exposed read-only to the daemon as /host-input. Any sale whose
# state references /host-input/<file> can only be auto-fulfilled while this
# directory contains that original file.
TRUSTDROP_HOST_INPUT_DIR=~/TrustDrop/TrustDrop/app/gui/demo-assets

# Walrus publisher process settings.
WALRUS_N_CLIENTS=1

# Optional host-local proxy settings. Keep real proxy values in docker/seller/seller.env,
# which is local-only and must not be committed.
# HTTPS_PROXY=
# HTTP_PROXY=
# ALL_PROXY=
NO_PROXY=127.0.0.1,localhost,walrus-publisher
