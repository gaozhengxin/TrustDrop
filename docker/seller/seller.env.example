# Host-side directories used by docker/seller/docker-compose.yml.
# On the Mac mini these defaults match the migrated TrustDrop environment.
# For another host, set absolute paths; the helper script expands ~/.sui to an absolute path.
TRUSTDROP_SUI_DIR=~/.sui
TRUSTDROP_WALRUS_DIR=~/walrus
TRUSTDROP_CARGO_HOME=~/.cargo-trustdrop-justin
TRUSTDROP_STATE_DIR=~/.trustdrop
TRUSTDROP_HOST_INPUT_DIR=~/TrustDrop/TrustDrop/app/gui/demo-assets
WALRUS_N_CLIENTS=1

# Optional host-local proxy settings. Keep real proxy values in docker/seller/seller.env,
# which is local-only and must not be committed.
# HTTPS_PROXY=
# HTTP_PROXY=
# ALL_PROXY=
NO_PROXY=127.0.0.1,localhost,walrus-publisher
