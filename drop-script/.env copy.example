SELLER_KEY=0x...
BUYER_KEY=0x...
SP1_PRIVATE_KEY=0x...
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
WALRUS_LOCAL_ENDPOINT=http://localhost:31415
