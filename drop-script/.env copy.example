ORACLE_WORKER_TOKEN=...
# Optional. Defaults to ${ORACLE_WORKER_URL}/status.
ORACLE_WORKER_STATUS_URL=https://trustdrop-oracle-worker.<your-subdomain>.workers.dev/status
