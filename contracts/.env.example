# 私钥 1: 系统管理员 (部署 Hub, Proxy, Implementation)
PRIVATE_KEY=0x...你的主私钥...

# 私钥 2: 中心化 Oracle Worker relayer
# 只在本地/Worker secret 中保存；脚本会从该私钥推导 signer 地址并配置 OracleProxy。
ORACLE_RELAYER_PRIVATE_KEY=0x...你的 oracle worker 私钥...

# 可选：要配置的 OracleProxy 地址。默认使用 contracts/deployed.md 中当前最新 OracleProxy。
ORACLE_PROXY_ADDRESS=0x13A59912Fe91211FB7a901974997F716f11EcFe8

# 可选：部署新 OracleProxy 时直接写入 signer 地址；通常由配置脚本从 ORACLE_RELAYER_PRIVATE_KEY 推导后设置。
CENTRALIZED_ORACLE_SIGNER=0x0000000000000000000000000000000000000000

# 可选：CRE-compatible forwarder。当前原型不用 CRE，保留兼容配置。
CRE_FORWARDER=0x76c9cf548b4179F8901cda1f8623568b58215E62

# 已部署地基地址 (Verifier)
VSS_ADDRESS=0xE57527263A7e0563e3719D96EfaA82bC3F12E575
VDD_ADDRESS=0x40379d9685ae004EfC438fd7d40434A7DFd460C5
